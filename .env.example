# Copy this to .env and fill in your values (never commit .env)

# Cloudflare D1 credentials
# Account ID: right sidebar on any Cloudflare dashboard page
CF_ACCOUNT_ID=your_account_id_here

# Database ID: Workers & Pages → D1 → your database → Settings
CF_DATABASE_ID=your_database_id_here

# API Token: dash.cloudflare.com → My Profile → API Tokens
# Needs "D1:Edit" permission on your account
CF_API_TOKEN=your_api_token_here
